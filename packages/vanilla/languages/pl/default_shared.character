  <comment key="intel radio reminder" text="Nie zapomnij, ze mozesz wezwac wsparcie lotnicze lub ostrzal, kiedy uznasz to za potrzebne." />

  <comment key="report very weak defense" text="Wywiad donosi, ze %base_name jest niemal pozbawione obrony." />
  <comment key="respond very weak defense" text="Jazda jazda jazda! Wrogie pozycje nie powinny stawiac oporu!" />
  <comment key="report weak defense" text="Wywiad donosi, ze w %base_name spotkac mozna tylko %enemy_range zolnierzy wroga." />
  <comment key="respond weak defense" text="Kontynuuj przejmowanie wrogich pozycji, liczymy na ciebie." />
  <comment key="report medium defense" text="Wywiad donosi, ze %base_name jest niezle bronione. Przynajmniej %enemy_range zolnierzy wroga w okolicy." />
  <comment key="respond medium defense" text="Sprobuj przejac wrogie pozycje, nie bedzie latwo, ale trzeba probowac." />
  <comment key="report heavy defense" text="Wywiad donosi, ze %base_name jest doskonale broniona. Wykryto az %enemy_range zolnierzy wroga w okolicy." />
  <comment key="respond heavy defense" text="Badz ostrozny, sprobuj przejac wrogie pozycje zachowujac najwyzsze srodki ostroznosci." />

