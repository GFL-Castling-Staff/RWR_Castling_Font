  <comment key="map start with 1 base, part 1" text="Uwaga, uwaga, zolnierze" />
  <comment key="map start with 1 base, part 2" text="Dobrze was widziec w bitwie o %map_name" />
  <comment key="map start with 1 base, part 3" text="Pluton przed wami przybyl i zabezpieczyl dla was %base_name" />

  <comment key="map start with 1 base, capture" text="Przybyly posilki, waszym zadaniem jest calkowite przejecie %map_name" />
  <comment key="map start with 1 base, koth" text="Glownym naszym celem jest obronienie %target_base_name" />

  <comment key="side objectives" text="Zadaniem dowodcow druzyn jest sabotaz baz przeciwnika" />
  <comment key="loot objective" text="Wrogie wozy zaopatrzenia nalezy wypatrzec i dostarczyc do naszej zbrojowni" />
  <comment key="radio tower or truck objective" text="Miejcie oko na wrogie wieze radiowe i wozy wsparcia" />
  <comment key="aa objective" text="Wrogie dzialo PLOT utrudniaja dostarczenie wsparcia, znalezc je i zniszczyc" />

  <comment key="map start, ending" text="Powodzenia, zolnierze!" />
  <comment key="map start, ending" text="Dacie rade, zolnierze!" />

  <comment key="map start with more bases, part 1" text="Dobrze cie widziec zolnierzu, przyda sie nam twoje wsparcie" />
  <comment key="map start with more bases, part 2" text="Udaje nam sie odpierac inwazje wroga, wciaz mamy %number_of_bases bazy" />

  <comment key="map start with completed map" text="Witaj ponownie, zolnierzu" />

  <comment key="map advance, held by enemy" text="Wywiad donosi ze %map_name zostalo podbite przez %faction_name" />
  <comment key="map advance, another enemy present" text="Wojska %faction_name zostaly zauwazone w rejonie operacji" />
  <comment key="map advance, new map" text="Nasze wojska traca pozycje za pozycja, potrzebne wsparcie" />
  <comment key="map advance, been there before" text="Dajemy rade, wciaz posiadamy %number_of_bases bazy" />
  <comment key="map advance, friendly map" text="%map_name zostalo podbite przez %faction_name coraz lepiej!" />

