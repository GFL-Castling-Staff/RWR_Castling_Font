	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Koledzy? My sie znamy?" />
		<comment text="Jakos cie nie kojarze..." />
		<comment text="Bo mam wrazenie, ze jestescie z przeciwnego teamu" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Niezle sie ten pojazd trzyma na tej tasmie" />
		<comment text="Caly wszechswiat trzyma sie na tasmie klejacej!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Jak wroce to zaloze Klapkart w Tesco" />
		<comment text="Doskonaly pomysl, sierzancie!" />
	</dialogue>  

  <dialogue key="vehicle dialogue 2 men">
      <comment text="Wiec to twoj pierwszy raz na misji?" />
      <comment text="Ta, boli mnie to bardzo" />
      <comment text="Jestes ranny!?" />
      <comment text="Nie, obieralem ziemniaki i sie zacialem" />
  </dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="... a kto kierowca k**a jest?!" />
		<comment text="Chorazy!!!" />
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="W armii sa dwie zasady" />
