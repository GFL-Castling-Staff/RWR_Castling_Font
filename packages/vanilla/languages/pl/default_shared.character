  <comment key="Final mission I advance, held by enemy, part 1" text="Dobra robota! %faction_name zostali odparci!" />
  <comment key="Final mission I advance, held by enemy, part 2" text="Niedobitki wroga po ostatniej bitwie zostaly rozpoznane niedaleko stad" />
  <comment key="Final mission I advance, held by enemy, part 3" text="Grupa naszych najlepszych ludzi zostanie wyslana na specjalna misje" />
  <comment key="Final mission I advance, held by enemy, part 4" text="Dolaczysz do oddzialu Delta I, by ruszyc na misje" />
  <comment key="Final mission I advance, held by enemy, part 5" text="Oczekujcie na transport smiglowcem" />

  <comment key="Final mission I start with 1 base, part 1" text="Cholera, przestrzen miala byc bezpieczna!" />
  <comment key="Final mission I start with 1 base, part 2" text="Oddzial Delta I zostal zestrzelony, tylko ty pozostales" />
  <comment key="Final mission I start with 1 base, part 3" text="Musisz poradzic sobie sam, nie mozemy wyslac wsparcia poki przestrzen nie jest bezpieczna" />
  <comment key="Final mission I start with 1 base, part 4" text="Artyleria i mozdzierze sa poza zasiegiem, kiepsko, nie?" />
  <comment key="Final mission I start with 1 base, part 5" text="Rozpoznaj teren i postaraj sie zlikwidowac cel" />

  <comment key="Final mission II advance, held by enemy, part 1" text="Dobra robota! %faction_name zostali odparci!" />
  <comment key="Final mission II advance, held by enemy, part 2" text="Pozostali zolnierze %faction_name rozbili oboz w Zamarznietym Kanionie" />
  <comment key="Final mission II advance, held by enemy, part 3" text="Nasz oddzial zwiadowczy zostal rozpoznany, przelicznik jest kiepski - ich 40, naszych 1" />
  <comment key="Final mission II advance, held by enemy, part 4" text="Wysylamy im wsparcie natychmiast" />
  <comment key="Final mission II advance, held by enemy, part 5" text="Spodziewajcie sie ciezkiego oporu i kiepskiej pogody" />

  <comment key="Final mission II start with 1 base, part 1" text="W ostatniej chwili! Wsparcie nadeszlo!" />
  <comment key="Final mission II start with 1 base, part 2" text="Wrog ma zamiar rozpoczac zmasowany atak" />
  <comment key="Final mission II start with 1 base, part 3" text="Przygotujcie sie do walki!" />
  <comment key="Final mission II start with 1 base, part 4" text="Utrzymac pozycje!" />
  <comment key="Final mission II start with 1 base, part 5" text="Za wszelka cene!" />

  <comment key="Final mission II, phase 2, part 1" text="Dobra robota! Zdaje sie ze morale wroga sie zalamuje!" />
  <comment key="Final mission II, phase 2, part 2" text="Teraz to oni przechodza do obrony" />
  <comment key="Final mission II, phase 2, part 3" text="To nasza szansa na kontratak" />
  <comment key="Final mission II, phase 2, part 4" text="Wrogi PLOT blokuje zrzut wsparcia, znalez i zlikwidowac" />
  <comment key="Final mission II, phase 2, part 5" text="Wrogi system lacznosci znajduje sie w zamku, wysadzic!" />

  <comment key="Final mission II, phase 3, part 1" text="Dobra robota, zdaje sie ze wrog okopal sie... w tej arenie?" />
  <comment key="Final mission II, phase 3, part 2" text="Wejscie zostalo dokladnie zamkniete" />
  <comment key="Final mission II, phase 3, part 3" text="Zdaje sie, ze caly kompleks polaczony jest z tym na poludniu" />
  <comment key="Final mission II, phase 3, part 4" text="Cel - wysadzic wrogie systemy lacznosci" />

  <comment key="Final mission II, phase 4, part 1" text="Kto by sie spodziewal... Cala wroga obrona na nic!" />
  <comment key="Final mission II, phase 4, part 2" text="Pora to zakonczyc! Ladujcie sie do srodka i wybijcie ich do nogi!" />

