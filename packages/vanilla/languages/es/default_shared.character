  <comment key="we have lost our last base" text="Hemos perdido nuestra última base - ¡Se ha perdido la batalla!" />
  <comment key="enemy has lost their last base" text="¡%faction_name ha sido derrotada!" />
  <comment key="our assault ran out of time" text="Nuestra ofensiva se quedó sin tiempo - ¡Se ha perdido la batalla!" />
  <comment key="enemy assault ran out of time" text="¡%faction_name ha sido derrotada!" />
  <comment key="we won by map conquer" text="¡Nuestra facción ha sido victoriosa! ¡Hemos capturado todas las bases en esta área!" />
  <comment key="we won by defense timer" text="¡Nuestra facción ha sido victoriosa!" />
  <comment key="our base is under attack" text="¡%base_name está siendo atacada!" />
  <comment key="we are attacking a base" text="Nuestras fuerzas están invadiendo %base_name" />
  <comment key="fighting near a base" text="Ha estallado una batalla cerca de %base_name" />
  <comment key="fighting near a base" text="Refuerzos solicitados cerca de %base_name" />
  <comment key="fighting near a base" text="Disparos cerca de %base_name" />
