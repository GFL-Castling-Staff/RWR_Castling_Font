  <comment key="Move out" text="Vamos" />
  <comment key="Move out" text="Síganme" />
  <comment key="Move out" text="Aprisa" />
  <comment key="All quiet here" text="Todo tranquilo por aquí" />
  <comment key="All quiet here" text="Todo parece en calma" />
  <comment key="All quiet here" text="*bostezando*" />
  <comment key="All quiet here" text="Nadie por ahí" />
  <comment key="All quiet here" text="*silbando*" />
  <comment key="All quiet here" text="¿La calma de antes de la tempestad?" />
  <comment key="All quiet here" text="Ningún rastro de enemigos aquí" />
  <comment key="All quiet here" text="Tan solo un par más de semanas..." />
  <comment key="Yes sir" text="Sí Señor" />
  <comment key="Yes sir" text="En ello" />
