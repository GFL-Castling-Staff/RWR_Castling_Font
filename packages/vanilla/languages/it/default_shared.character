  -->
  <comment key="Final mission I advance, held by enemy, part 1" text="Ottimo lavoro! La fazione %faction_name è stata respinta con successo" />
  <comment key="Final mission I advance, held by enemy, part 2" text="Abbiamo individuato gli ufficiali nemici rimasti, sono nascosti in una città deserta vicina" />
  <comment key="Final mission I advance, held by enemy, part 3" text="Manderemo una squadra dei nostri uomini migliori a distruggere la base ed eliminare i nemici rimanenti" />
  <comment key="Final mission I advance, held by enemy, part 4" text="Vi unirete a Delta Uno e Due e fornirete assistenza" />
  <comment key="Final mission I advance, held by enemy, part 5" text="Attendete gli elicotteri per il trasporto" />
  <comment key="Final mission I start with 1 base, part 1" text="Merda, pensavamo che lo spazio aereo fosse sicuro!" />
  <comment key="Final mission I start with 1 base, part 2" text="Abbiamo perso Delta Uno e Due, restate solo voi" />
  <comment key="Final mission I start with 1 base, part 3" text="Siete da soli - non possiamo fornire supporto aereo finchè non sappiamo qual'è la situazione" />
  <comment key="Final mission I start with 1 base, part 4" text="E l'artiglieria e i mortai sono troppo lontani. Siete proprio sfigati, eh?" />
  <comment key="Final mission I start with 1 base, part 5" text="Individuate e distruggete le strutture di comunicazione in zona, ed eliminate il nemico" />
  <comment key="Final mission II advance, held by enemy, part 1" text="Ben fatto! La fazione %faction_name è stata respinta con successo" />
  <comment key="Final mission II advance, held by enemy, part 2" text="Una squadra di ricognizione ha individuato le ultime unità %faction_name; si sono accampate a Frozen Canyon" />
  <comment key="Final mission II advance, held by enemy, part 3" text="La squadra è stata compromessa, ha dovuto ingaggiare uno scontro a fuoco in netta inferiorità numerica" />
  <comment key="Final mission II advance, held by enemy, part 4" text="Il trasporto dei rinforzi partirà immediatamente" />
  <comment key="Final mission II advance, held by enemy, part 5" text="Aspettatevi clima sfavorevole e una feroce resistenza" />
  <comment key="Final mission II start with 1 base, part 1" text="Sono arrivati i rinforzi, appena in tempo!" />
  <comment key="Final mission II start with 1 base, part 2" text="Il nemico sta per attaccare la base, abbiamo mantenuto la posizione a fatica" />
  <comment key="Final mission II start with 1 base, part 3" text="Preparatevi. Nessuna resa!" />
  <comment key="Final mission II start with 1 base, part 4" text="Mantenete la posizione e avanzate al mio segnale!" />
  <comment key="Final mission II start with 1 base, part 5" text="" />
  <comment key="Final mission II, phase 2, part 1" text="Ottimo lavoro! Il morale del nemico sta cedendo" />
  <comment key="Final mission II, phase 2, part 2" text="Sembra che ora stiano preparando le difese" />
  <comment key="Final mission II, phase 2, part 3" text="E' la nostra occasione per avanzare, ci siamo!" />
  <comment key="Final mission II, phase 2, part 4" text="La postazione antiaerea in questo sito ci sta impedendo di ricevere rinforzi, distruggetela" />
  <comment key="Final mission II, phase 2, part 5" text="Un centro comunicazioni nemico è stato localizzato tra le rovine del castello, trovate un modo per entrare e distruggetelo" />

  <comment key="Final mission II, phase 3, part 1" text="Ben fatto! Sembra che le forze nemiche rimaste si siano barricate in quella.. arena?" />
  <comment key="Final mission II, phase 3, part 2" text="L'entrata è stata sigillata!" />
  <comment key="Final mission II, phase 3, part 3" text="Sembra esserci una connessione tra il cancello e un centro di comunicazioni a sud" />
  <comment key="Final mission II, phase 3, part 4" text="Distruggi il centro di comunicazioni" />

  <comment key="Final mission II, phase 4, part 1" text="Ma chi se lo sarebbe aspettato - il cancello è crollato!" />
  <comment key="Final mission II, phase 4, part 2" text="E' l'ora della verità uomini, entrate nell'arena e finiteli!" />
