  <comment key="celebrating" text="Vittoria!" />
  <comment key="celebrating" text="Sono ancora vivo!" />
  <comment key="celebrating" text="Sono vivo!" />
  <comment key="celebrating" text="Woo-hoo" />
  <comment key="celebrating" text="GG" />
  <comment key="celebrating" text="SEEEEEEEEEEH!" />
  <comment key="celebrating" text="Non ci credo, sono ancora vivo" />
  <comment key="celebrating" text="Bella lì!" />
  <comment key="celebrating" text="E' stato brutale" />
  <comment key="celebrating" text="!" />
  <comment key="celebrating" text=":D" />
  <comment key="celebrating" text="Sono veramente euforico!" />
  <comment key="celebrating" text="Finalmente! Devo pisciare!" />
  <comment key="celebrating" text="E' stato così lungo che penso di essere invecchiato!" />
  <comment key="celebrating" text="Che partita stancante!" />
  <comment key="celebrating" text="E' così che si fa! Fácile" />
  <comment key="celebrating" text="Così!" />
  <comment key="celebrating" text="Geeeeniale!" />
  <comment key="celebrating" text="¡Yeah!" />
  <comment key="about to drive over a friendly" text="Attento!" />
  <comment key="about to drive over a friendly" text="Via dalla mia strada!" />
  <comment key="this is as close as i can get" text="Non posso avvicinarmi più di così" />
  <comment key="this is as close as i can get" text="Impossibile proseguire" />
  <comment key="enemy vehicle spotted, near base" text="%vehicle_name dei %enemy_name vicino a %base_name" />
  <comment key="enemy vehicle spotted, not near base" text="Localizzato %vehicle_name dei %enemy_name" />
  <comment key="comms have been restored" text="Comunicazioni ristabilite" />
  <comment key="enemy comms have been restored" text="%enemy_name hanno ristabilito le comunicazioni" />
  <comment key="comms have been destroyed" text="Comunicazioni interrotte" />
  <comment key="enemy comms have been destroyed, by us" text="Bene, abbiamo interrotto le comunicazioni dei %enemy_name !" />
  <dialogue key="wander dialogue 2 men">
    <comment text="Guarda questo posto" />
    <comment text="E' così tranquillo" />
    <comment text="Penso che potrei viverci" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Ci sono già stato qui prima" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Servirebbe un po' d'azione qui" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Oggi mi sento invincibile" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Arruolati nell'esercito, hanno detto. Sarà divertente, hanno detto." />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Avrei fatto meglio ad entrare in Marina" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Pensi che arriveranno presto?" />
    <comment text="Nah, non credo" />
  </dialogue>
  <dialogue key="wander dialogue 2 men">
    <comment text="Vuoi vedere una cosa interessante?" />
    <comment text="Non ci casco di nuovo" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sapete, il Sergente ed io eravamo in territorio nemico" />
    <comment text="Ah, facevi parte di una squadra di ricognizione?" />
    <comment text="Si, avevamo trovato anche un camion cargo" />
    <comment text="Wow, grande" />
    <comment text="Le incursioni di ricognizione sono meglio di questa roba" />
    <comment text="Almeno qui si vive di più" />
    <comment text="Come se ci fossero cose più importanti" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Non dite a mia madre che mi sono arruolato nell'esercito" />
    <comment text="Cosa le hai detto tu?" />
    <comment text="Le ho detto che suono il pianoforte in un bordello" />
    <comment text="Ah, bene" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Questa guerra sembra così irreale" />
    <comment text="Hmm?" />
    <comment text="Un mese fa stavo giocando a Running With Rifles" />
    <comment text="Ah, allora fai parte del gioco" />
    <comment text="Esatto" />
    <comment text="Pensa se avessimo giocato a Leisure Suit Larry" />
    <comment text="LOL" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
		<comment text="Quindi sei stato mandato in ricognizione?" />
		<comment text="Sì, che schifo. Ho fatto un casino" />
		<comment text="Che hai fatto?" />
		<comment text="Non dirlo a nessuno, ho fatto saltare in aria un camion da trasporto" />
		<comment text="Com'è possibile, mentre stavi tornando dal territorio nemico?" />
		<comment text="Non era un camion nemico quello che ho fatto saltare" />
		<comment text="Oh merda, brutta storia" />
		<comment text="Lo è" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
   <comment text="Hai delle sigarette?" />
		<comment text="Purtroppo le ho finite, non sapevo che fumassi" />
		<comment text="Non fumo, voglio scambiarle per una nuova arma" />
		<comment text="Cos'ha la tua che non va?" />
		<comment text="Penso che ha troppa sabbia dentro" />
		<comment text="Dovresti semplicemente pulirla" />
		<comment text="Beh, all'armeria avessero finito il cotone per la pulizia" />
		<comment text="Non ci credo" />
		<comment text="Hanno dozzine di armi ma non hanno gli strumenti per tenerle pulite" />
		<comment text="Secondo me credono che non sopravviveremo abbastanza per poterle pulire" />
		<comment text="E' un'ipotesi interessante" />

  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Nessun segno del camion comunicazioni?" />
    <comment text="Nessuno, però sono sicuro che non è qui" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sai che ho trovato Whisky e l'ho nascosto?" />
    <comment text="Shh non farti sentire, è proibito tenerlo" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Stavo pensando..." />
    <comment text="Cosa?" />
    <comment text="Hmm, mi è sfuggito di mente" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sta guerra è assurda!" />
    <comment text="Perchè scusa?" />
    <comment text="Beh, dimmi perchè siamo qua" />
    <comment text="Già vero, non ce l'hanno mai detto" />
    <comment text="Sarò anche paranoico ma la cosa puzza" />
    <comment text="Io credo che stiamo liberando questo paese e la sua gente da un tiranno" />
    <comment text="A me sembra che stiamo invadendo il paese fregandocene della gente" />
    <comment text="Devi smetterla di pensare o ci farai denunciare!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Signore, perchè non stiamo facendo niente??" />
    <comment text="Non mettere in discussione gli ordini, ragazzo. Mettere in discussione gli ordini ti farà ammazzare" />
    <comment text="Signore, sissignore" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sai qual è il mio sport preferito?" />
    <comment text="No, qual'è?" />
    <comment text="La patata bollente" />
    <comment text="Mica è uno sport" />
    <comment text="Lo è quando usi granate ad impatto" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Non credo sia una buona idea unirmi al coro dell'esercito" />
    <comment text="Perchè no?" />
    <comment text="Beh, l'ultima volta che sono stato in un coro fu nel coro della chiesa" />
    <comment text="E?" />
    <comment text="E 200 persone cambiarono religione" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Meno male che il nemico non ci sta attaccando alle spalle" />
    <comment text="Già, non saremmo proprio molto preparati per quello" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
		<comment text="Di recente mi sono scontrato con gli sviluppatori" />
		<comment text="Intendi Pasik and JackMayol" />
    <comment text="Yes, Pasik ha la mira di una vecchietta ma JackMayol è anche peggio!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="'Osumia Games'... chi è che se ne esce con questi nomi?" />
    <comment text="Aspè, di che stai parlando?" />
    <comment text="Non lo so nemmeno io" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="A volte mi sembra che stiamo semplicemente correndo con i fucili" />
    <comment text="Sei proprio intelligente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="AHIA, il piede!" />
    <comment text="Scusa compagno" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="E' già uscito questo gioco?" />
    <comment text="Certo, lo trovi su Steam!" />
    <comment text="Fantastico" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Amico, hai mollato una scoreggia per caso?" />
    <comment text="Può essere" />
    <comment text="Merda! Abbassate i finestrini!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Sai una cosa?" />
    <comment text="Hmm?" />
    <comment text="Credo di amarti" />
    <comment text="Mi spiace ma ti vedo più come un amico" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Dove hai preso la patente?" />
    <comment text="Me l'ha data tua madre" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Mettete qualche canzone di Gigi D'Alessio?" />
    <comment text="Voglio disertare" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Non mi sento al sicuro qui dentro" />
    <comment text="Perchè?" />
    <comment text="Guarda le ruote" />
    <comment text="Che hanno le ruote?" />
    <comment text="Non sono nemmeno connesse agli assi" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ho una voglia matta di ascoltare la radio" />
    <comment text="Anche io" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Mi cago sempre sotto quando sono in squadra con te" />
    <comment text="Che c'è che non va?" />
    <comment text="Gli oggetti strani attirano il fuoco. Tu sei strano" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
		<comment text="Si ha sempre successo quando nessuno sta guardando" />
		<comment text="E si fallisce sempre quando il comandante sta guardando" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Occhio alle granate ad impatto" />
    <comment text="Sí, fanno più danni delle granate a mano" />
    <comment text="Per fortuna hanno un raggio d'azione minore" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
		<comment text="Le granate stordenti non sono utili come si può pensare" />
		<comment text="Sì, stordiscono il nemico per un po'" />
		<comment text="E hanno un raggio d'azione abbastanza grande!" />    
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Potevamo essere a casa ad oziare" />
    <comment text="Bere qualche birretta" />
    <comment text="Giocare a RUNNING WITH RIFLES" />
    <comment text="Ma noo, dobbiamo servire la nostra nazione invece" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Mi sa che devo tornare in armeria" />
    <comment text="Perchè?" />
    <comment text="Mi sono dimenticato il giubotto antiproiettile" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
		<comment text="Qualche ragazza in più nell'esercito non farebbe male" />
		<comment text="Sono d'accordo, aiuterebbero con gli ormoni" />
		<comment text="No, non intendevo quello..." />
		<comment text="E cosa allora?" /> 
		<comment text="Avremmo qualcuno per stirare, cucinare, pulire.." />      
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Avrebbero potuto mettere qualche poligono in più qui" />
    <comment text="Perchè?" />
    <comment text="Questi sedili sono troppo appuntiti" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Finalmente è VENERDI'! VENERDI'! *canta*" />
    <comment text="Dovresti fare il cantante" />
    <comment text="Dici seriamente?" />
    <comment text="Certo, così non dovremo più sentirti tutto il santo giorno" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ti hanno dato l'equipaggiamento nuovo?" />
    <comment text="Sí" />
    <comment text="Cazzo, non è giusto..." />
    <comment text="Geloso?" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ti potresti spostare un pochino?" />
    <comment text="No" />
    <comment text="Grazie" />
    <comment text="Prego" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Un giorno senza sole è come, tipo.. La notte" />
    <comment text="Attenzione, abbiamo un poeta tra noi" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Sapete le previsioni per il meteo di stanotte?" />
    <comment text="Buio!" />
    <comment text="Non è possibile..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Di chi è sto telefono che suona?!" />
    <comment text="Non è un telefono, è il mio Tamagotchi" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Vorrei che più gente giocasse in PvP" />
    <comment text="Perchè?" />
    <comment text="Almeno lascierebbero vivere noi bot" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Nel dubbio, svuotate il vostro caricatore" />
    <comment text="Sissignore!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ho un'idea" />
    <comment text="Lascia perdere, non esiste il piano perfetto" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Siete carichi ragazzi?" />
    <comment text="Signore, sissignore!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Non dimenticate cosa vi ho detto stamattina" />
    <comment text="Sissignore!" />
    <comment text="Se l'attacco sta andando bene, allora è un'imboscata!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Penso che sia un piano stupido" />
    <comment text="Se è stupido e funziona, allora non è stupido" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Cosa facciamo se le cose vanno male?" />
    <comment text="Attacco di artiglieria" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
      <comment text="Quand'è stata l'ultima volta che hai guidato?" />
      <comment text="Oh, questa è la mia prima volta" />
      <comment text="E perchè cazzo stai guidando tu?" />
      <comment text="..." />
      <comment text="Mi farai ammazzare ancora prima che raggiungiamo il fronte" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="" />
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men">
    <comment text="Ci sono solo due regole nell'esercito" />
    <comment text="E sono?" />
    <comment text="#1: L'ufficiale ha sempre ragione" />
    <comment text="#2: Se l'ufficiale ha torto, vedere regola #1" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=campfire">
    <comment text="Mi bruciano i piedi" />
    <comment text="Muoviti allora" />
    <comment text="Non posso" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Amo questo carro" />
    <comment text="E zitto" />
    <comment text="Non posso" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
      <comment text="Che nome diamo al carro?" />
      <comment text="Perchè vuoi dargli un nome?" />
      <comment text="Beh lo terremo per un po', quindi..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="La miglior armatura? Rimanere fuori dalla portata del nemico" />
    <comment text="Madonna quanto sei genio" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Questa è Spartaaaaaaaah!" />
    <comment text="..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Preparatevi a mangiar metallo!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Il miglior terreno per un carro è quello senza trappole anticarro" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Non ci sono problemi che non possano essere risolti con l'uso di esplosivo" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
         <comment text="Oh, perchè c'è un gatto nel carro?!" />
      <comment text="Il visore notturno è rotto, ecco perchè" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
    <comment text="Sapete perchè chiamiamo la fanteria 'schiacciatine'?" />
    <comment text="No, perchè?" />
    <comment text="Perchè è quello che diventano quando gli passiamo sopra" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Ouch" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Credo che mi vomiterò a breve" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Non credo che questo tizio sappia dove sta andando" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Siamo arrivati?" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="ZZZ" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="lol, la tua faccia!" />
    <comment text="Che ha?" />
    <comment text="E' piena di voxels" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    		<comment text="Mi fa morire come nei film horror la gente grida sempre 'C'è qualcuno?'" />
		<comment text="Come se l'assassino rispondesse 'Sì sono nella cucina, vuoi un panino?'" />   
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Vorrei che il giocatore potesse vedere l'interno dei veicoli" />
    <comment text="Già, non ci sono dettagli" />
    <comment text="Sviluppatori pigri!" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Penso che mi sentirei più sicuro fuori da questa cosa" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Immaginate una buona pizza" />
		<comment text="O un gelato" />
		<comment text="O pollo arrosto" />
		<comment text="O insalata di tofu" />
		<comment text="Che?!" />     
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Cazzo, che hai mangiato stamattina? Un cimitero?" />
    <comment text="Scusami, ma ho perso lo spazzolino la settimana scorsa" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="A cosa serve questo tasto verde?" />
    <comment text="Uh... a niente..." />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Hei, potresti riavviare la partita per favore?" />
    <comment text="Che succede?" />
    <comment text="Sono bloccato in questa texture" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Dovresti metterti un casco invece di sta fascia rossa in testa" />
    <comment text="Forse sì, ma con questa sembro un boss" />
    <comment text="Ai proiettili frega niente" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Qui dentro c'è puzza di piedi voxellati" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="" />
  </dialogue>
  <dialogue key="vehicle dialogue 2 men tag=truck">
    <comment text="Ti ricordi quel film in cui i camionisti salvavano il mondo?" />
    <comment text="Mhm, no" />
    <comment text="Già nemmeno io. Moriremo tutti" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Sono sicuro che verrò promosso a breve" />
    <comment text="Mi raccomando non farti ammazzare prima!" />
    <comment text="Grazie compagno, sei una persona fantastica" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Mi sento troppo bene, amico" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Penso di essere già spawnato 100 volte" />
    <comment text="Anche io" />
    <comment text="Immagina se potessi farlo realmente" />
    <comment text="Heh" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Son stanco dei vecchi che ai matrimoni mi indicano dicendomi 'tu sarai il prossimo'" />
    <comment text="Fai la stessa cosa ai loro finerali" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Quando si mettono i call center sono veramente rompipalle" />
    <comment text="Prova a dare il telefono a tua figlia di 3 anni e dirgli che è Babbo Natale" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Ho fatto un sogno stranissimo la scorsa notte" />
    <comment text="Ovvero?" />
    <comment text="C'erani numeri 1 e 0 da ogni parte" />
    <comment text="E che ha di strano?" />
    <comment text="All'improvviso ho visto un 2!" />
    <comment text="Ooooh, che paura" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Mia moglie dice che sono brutto, la mia amante dice che sono bello" />
    <comment text="Quindi?" />
    <comment text="Tu che ne pensi?" />
    <comment text="Hmmm, penso un po' tutti e due, sei bel bruttone" />
    <comment text="Dai, puoi fare il serio almeno una volta?" />
    <comment text="Fidati, sono serio" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Amico, parli troppo" />
    <comment text="E' una cosa di famiglia" />
    <comment text="Che intendi?" />
    <comment text="Mio nonno era un venditore ambulante, mio padre un professore" />
    <comment text="E tua madre?" />
    <comment text="Beh, mia madre è una donna" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Come avviso mio padre?" />
    <comment text="Di cosa?" />
    <comment text="Che non ho ottenuto la promozione" />
    <comment text="Mandagli un telegramma" />
    <comment text="E che ci scrivo?" />
    <comment text="'Rendimento pari ad anno scorso'" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Mi manca il mio smartphone" />
    <comment text="Già, niente Facebook, niente Twitter, una palla" />
    <comment text="Quello che mi manca di più è YouPorn" />
    <comment text="Mai sentito" />
    <comment text="Ceeeerto" />
    <comment text="lol" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Meno male che gli sviluppatori non hanno messo velivoli" />
    <comment text="Già, una cosa in meno a cui pensare" />
    <comment text="Vero, non dobbiamo pensare a cose che arrivano dall'alto" />
    <comment text="A parte l'artiglieria e i mortai.. cazzo!" />
    <comment text="Ci eravamo dimenticati delle cacche di piccione" />
    <comment text="Ma dio" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="I soldati professionisti sono prevedibili" />
    <comment text="Però il mondo è pieno di dilettanti pericolosi" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Tutte queste chiacchiere sull'Intelligence Militare..." />
    <comment text="Che problema c'è?" />
    <comment text="'Intelligence' e 'Militare' insieme è un po' contraddittorio" />
    <comment text="Ma parla per te!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Vorrei poter veder lontano quanto il giocatore" />
    <comment text="Giocatore?" />
    <comment text="Sì, quello dietro lo schermo che ci sta osservando" />
    <comment text="Vero, sembra quasi come cheattare" />
    <comment text="E poi non sopporto il sorrisetto idiota che ha stampato in faccia!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Se hai un conflitto di personalità con un tuo superiore..." />
    <comment text="Cosa?" />
    <comment text="... lui ha la personalità, tu hai il conflitto" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Più il caposquadra è stupido, più sono importanti le missioni che gli danno da fare" />  
    <comment text="Hai troppo ragione" />    
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Esiste sempre un modo" />
    <comment text="E solitamente non funziona" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Hai visto la nuova moglie del comandante?" />  
    <comment text="Intendi quella con il naso lungo?" /> 
    <comment text="Esatto, può fumare sotto la doccia con un naso come quello" />     
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="E' vero che l'uomo discende dalla scimmia?" />
    <comment text="Sì, i soldati probabilmente sì. Ma non i sergenti" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Recentemente una ragazza travestita da uomo si è unita all'esercito" />
       <comment text="Dovrà vestirsi insieme ai ragazzi e fare la doccia con loro, giusto?" /> 
    <comment text="Giusto" />  
    <comment text="Beh, non pensi che lo scopriranno?" /> 
    <comment text="Secondo te lo andranno a dire in giro?" />   
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Perchè ci servono bombe ancora più costose?" />  
    <comment text="Che ne so" /> 
    <comment text="Quelli che abbiamo bombardato per tutti questi anni si sono lamentati?" />   
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Perchè i nostri si sono ritirati in questi ultimi giorni?" />
    <comment text="Non si sono ritirati, sono avanzati nella direzione opposta" />
    <comment text="Ah bene!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Anche se sei daltonico puoi comunque essere utile nell'Esercito" />
    <comment text="Grazie per il tuo supporto, amico" />
    <comment text="Semplicemente... spara a quello a cui sparo io" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="La guerra è il modo in cui Dio insegna la geografia agli ignoranti" />
    <comment text="Assolutamente vero" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Non interrompere il nemico quando sta facendo un errore" />
    <comment text="" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Ci sono tanti oggetti di valore sparsi per il campo di battaglia" />  
    <comment text="E molti soldati se ne fregano" /> 
    <comment text="Anche se venderli all'armeria ne vale la pena" />    
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Devo essere concentrato al massimo oggi" />  
    <comment text="Qualcosa di speciale in mente?" /> 
    <comment text="Magari uno YouTuber oggi va un video" />
    <comment text="E tu gli vuoi mettere i bastoni tra le ruote" /> 
    <comment text="Esatto!" />       
  </dialogue>
  <dialogue key="defense dialogue 2 men">
      <comment text="Stavo pensando..." />
      <comment text="Cosa?" />
      <comment text="Da dove arrivano i nostri rinforzi?" />
      <comment text="?" />
      <comment text="Beh, non arrivano con trasporti o robe simili" />
      <comment text="Quindi mi stai dicendo che appaiono come per magia?" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
    <comment text="Mai scureggiato?" />
    <comment text="Hehe!" />
    <comment text="Sei un maiale" />
    <comment text="Sissignore!" />
  </dialogue>
  <dialogue key="defense dialogue 2 men">
       <comment text="Non ci pagano abbastanza per quello che facciamo" />
      <comment text="Non mi pagano abbastanza per dover vedere la tua faccia, Drake" />
      <comment text="E' una battuta?" />
      <comment text="Oh, quanto vorrei che lo fosse" />
  </dialogue>
