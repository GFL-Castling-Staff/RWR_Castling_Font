  <comment key="Final mission I advance, held by enemy, part 1" text="Gute Arbeit! Die %faction_name wurden erfolgreich zurückgedrängt" />
  <comment key="Final mission I advance, held by enemy, part 2" text="Die überlebenden feindlichen Offiziere wurden in einem abgelegenen Dorf gesichtet" />
  <comment key="Final mission I advance, held by enemy, part 3" text="Eine Gruppe unserer besten Männer wird auf eine Zerstörungsmission geschickt um die restlichen Feinde auszuschalten" />
  <comment key="Final mission I advance, held by enemy, part 4" text="Sie werden Delta Eins und Zwei zugeteilt um die Gruppe zu unterstützen" />
  <comment key="Final mission I advance, held by enemy, part 5" text="Warte auf Hubschrauber Transport" />

  <comment key="Final mission I start with 1 base, part 1" text="Verdammt! Es wurde doch bestätigt, dass der Luftraum sicher sei!" />
  <comment key="Final mission I start with 1 base, part 2" text="Delta Eins und Zwei sind gefallen, es bleiben nur noch Sie um die Mission zu erfüllen!" />
  <comment key="Final mission I start with 1 base, part 3" text="Sie sind auf sich selbst gestellt - Luftunterstützung kann nicht gewährleistet werden solange die Situation am Boden unklar ist" />
  <comment key="Final mission I start with 1 base, part 4" text="Artillerie und Mörserstellungen sind ausserdem ausser Reichweite, da müssen wir ohne auskommen" />
  <comment key="Final mission I start with 1 base, part 5" text="Orten sie die feindlichen Funktürme, zerstören sie diese und tun Sie das selbe mit dem Feind allgemein!" />

  <comment key="Final mission II advance, held by enemy, part 1" text="Gute Arbeit! %faction_name wurde erfolgreich zurückgedrängt" /> 
  <comment key="Final mission II advance, held by enemy, part 2" text="Ein Zug unserer Armee hat die %faction_name aufgespürt, sie haben ein Camp im Frozen Canyon" />
  <comment key="Final mission II advance, held by enemy, part 3" text="Die Lage des Zuges wurde gefährdet, sie mussten einer deutlichen Überzahl des Gegners standhalten" />
  <comment key="Final mission II advance, held by enemy, part 4" text="Der Verstärkungstransport bringt Sie sofort dorthin" />
  <comment key="Final mission II advance, held by enemy, part 5" text="Stellen Sie sich auf massive Gegenwehr und harte Wetterkonditionen ein!" />

  <comment key="Final mission II start with 1 base, part 1" text="Verstärkung ist gerade noch rechtzeitig eingetroffen" />
  <comment key="Final mission II start with 1 base, part 2" text="Der Feind stürmt auf unsere Basis zu, wir können kaum noch die Linie halten" />
  <comment key="Final mission II start with 1 base, part 3" text="Seid bereit und gebt niemals auf!" />
  <comment key="Final mission II start with 1 base, part 4" text="Halten Sie die Stellung und stossen Sie erst vor, wenn ich es Ihnen sage!" />
  <comment key="Final mission II start with 1 base, part 5" text="" />

  <comment key="Final mission II, phase 2, part 1" text="Gute Arbeit! Es scheint als lasse die Moral der Feinde nach" />
  <comment key="Final mission II, phase 2, part 2" text="Sie scheinen nun eine Verteidigungsstrategie einzugehen" />
  <comment key="Final mission II, phase 2, part 3" text="Das ist die Gelegenheit vorzustossen, das ist es!" />
  <comment key="Final mission II, phase 2, part 4" text="Eine feindliche Luftabwehrstellung unterbindet das Eintreffen unserer Verstärkung, spürt sie auf und schaltet sie aus!" />
  <comment key="Final mission II, phase 2, part 5" text="Eine Störfunkturm wurde in der Burgruine gesichtet, findet einen Weg dorthin und zerstört ihn!" />

  <comment key="Final mission II, phase 3, part 1" text="Bravo! Die übrigen feindlichen Einheiten scheinen sich in einer Art Arena verschanzt zu haben?" />
  <comment key="Final mission II, phase 3, part 2" text="Der Zugang wurde versperrt!" />
  <comment key="Final mission II, phase 3, part 3" text="Es scheint eine Art Verbindung zwischen Tor und Kommunikationsstruktur im Süden zu geben" />
  <comment key="Final mission II, phase 3, part 4" text="Sprengen Sie diese!" />

  <comment key="Final mission II, phase 4, part 1" text="Wer hätte das gedacht! Das Tor ist völlig zerstört!" />
  <comment key="Final mission II, phase 4, part 2" text="Wir haben es bald geschafft, gehen Sie in die Arena und macht sie fertig!" />

