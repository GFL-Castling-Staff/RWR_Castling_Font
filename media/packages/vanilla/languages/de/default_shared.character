  <comment key="map start with 1 base, part 1" text="Achtung, Lagebesprechung des Kommandanten:" />
  <comment key="map start with 1 base, part 2" text="Schön, Sie alle hier zu haben, bei %map_name" />
  <comment key="map start with 1 base, part 3" text="Der Vorbereitungszug ist früher angekommen als erwartet und hat den Umkreis von %base_name abgesichert" />

  <comment key="map start with 1 base, capture" text="Jetzt, wo Verstärkung nachgerückt ist, ist unser Ziel %map_name komplett zu kontrollieren" />
  <comment key="map start with 1 base, koth" text="Unsere erste Aufgabe ist es %target_base_name einzunehmen und zu verteidigen" />

  <comment key="side objectives" text="Squad-Anführer werden dazu ermutigt Sabotage-Missionen durchzuführen" />
  <comment key="loot objective" text="Wertsachen und Frachttrucks sollen an Waffenkammern zur Untersuchung geliefert werden" />
  <comment key="radio tower or truck objective" text="Haltet eure Augen offen und meldet Funktürme oder Kommunikationstrucks hinter feindlichen Linien" />
  <comment key="aa objective" text="Feindliche Luftabwehrstellungen unterbinden Luftabwürfe in der Umgebung, spürt sie auf und zerstört sie" />

  <comment key="map start, ending" text="Viel Erfolg, Soldaten" />
  <comment key="map start, ending" text="Viel Glück, Soldaten" />

  <comment key="map start with more bases, part 1" text="Gute Sachem Sie bei uns zu haben, wir können jede Unterstützung hier gut gebrauchen" />
  <comment key="map start with more bases, part 2" text="Wir haben es geschafft unsere Position zu halten, indem wir %number_of_bases Basen kontrollieren" />

  <comment key="map start with completed map" text="Willkommen zurück, Soldat" />

  <comment key="map advance, held by enemy" text="Der Geheimdienst hat uns informiert, dass %map_name von den %faction_name kontrolliert wird" />
  <comment key="map advance, another enemy present" text="Die %faction_name wurden ebenfalls in der Region gesichtet" />
  <comment key="map advance, new map" text="Unsere Kräfte tun sich schwer, Fuss zu fassen, Unterstützung beantragt" />
  <comment key="map advance, been there before" text="Wir kontrollieren immer noch %number_of_bases Basen" />
  <comment key="map advance, friendly map" text="%map_name wird von den %faction_name kontrolliert, ziemlich friedlich hier" />

