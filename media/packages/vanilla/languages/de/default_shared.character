	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Bin mir nicht sicher, ob der Kerl weiss wo es langgeht" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
