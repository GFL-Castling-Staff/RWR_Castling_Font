	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Hab' schon immer Schiss gehabt ins selbe Squad wie du eingeteilt zu werden" />
		<comment text="Was hab ich denn wieder getan?" />
		<comment text="Seltsame Objekte ziehen Feuer an. Du bist seltsam" />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Erfolg passiert immer wenn keiner zuschaut" />
		<comment text="Misserfolg geschieht wenn der Kommandeur zuschaut..." />
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Pass auf Aufschlaggranaten auf" />
