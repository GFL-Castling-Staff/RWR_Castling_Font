	<comment key="enemy vehicle spotted, near base" text="%enemy_name %vehicle_name bei %base_name" />
	<comment key="enemy vehicle spotted, not near base" text="%enemy_name %vehicle_name gesichtet" />

	<comment key="comms have been restored" text="Die Funkverbindung wurde wieder hergestellt"/>
	<comment key="enemy comms have been restored" text="%enemy_name Funkverbindung wurde vollständig wieder hergestellt" />

	<comment key="comms have been destroyed" text="Die Funkkommunikation wurde zerstört!" />
	<comment key="enemy comms have been destroyed, by us" text="Gute Arbeit, die Funkverbindung der %enemy_name wurde sabotiert!" />  

	<dialogue key="wander dialogue 2 men">
		<comment text="Schau dir diese Gegend an man" />
		<comment text="So ruhig" />
		<comment text="Könnte fast hier leben" />
	</dialogue>

	<dialogue key="wander dialogue 2 men">
		<comment text="Hmm hier war ich doch schonmal" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Wir brauchen hier ein bisschen mehr Action" />
	</dialogue>  

	<dialogue key="wander dialogue 2 men">
		<comment text="Fühl' mich heute unbesiegbar" />
	</dialogue>
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Geht zur Armee haben sie gesagt, es wird lustig sagten sie..." />
	</dialogue>  
  
	<dialogue key="wander dialogue 2 men">
		<comment text="Wenn ich gewusst hätte, wie viel wir laufen müssen wäre ich zur Marine" />
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="Wirst du bald befördert?" />
		<comment text="Denk eher nicht" />
	</dialogue>
  
  <dialogue key="wander dialogue 2 men">
      <comment text="Willst du mal was cooles sehen?" />
      <comment text="Nee, werde da nicht nochmal reinfallen..." />
   </dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="Weisst du, wir waren hinter feindlichen Linien, Alex und ich" />
		<comment text="Also bist du einem Aufspühr-Squad beigetreten?" />
		<comment text="Jupp, wir haben auch ein Frachtfahrzeug geortet" />
		<comment text="Wow, das ist ziemlich abgefahren" />
		<comment text="Bestimmt mehr als hier rumhängen zumindest" />
		<comment text="Naja zumindest lebt man hier länger" />
		<comment text="Als ob das alles wäre..." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Sag meiner Mutter bloss nicht, dass ich bei der Armee bin" />
		<comment text="Wieso denn nicht?" />
		<comment text="Sie denkt ich spiele Klavier in einem Bordell.." />
		<comment text="Oh ok" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Der ganze Krieg hier ist so irreal für mich" />
		<comment text="Hmm?" />
		<comment text="Noch vor einem Monat war ich der, der Running With Rifles spielt" />
		<comment text="Ja und nun bist du mitten drin in dem Spiel" />
		<comment text="Genau" />
		<comment text="Du hättest vielleicht eher ein Pornospiel zocken sollen!" />
		<comment text="Haha" />            
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Du wurdest also auf Patrouille geschickt?" />
		<comment text="Ja, hab es volle Kanne verkackt" />
		<comment text="Was hast du denn angerichtet?" />
		<comment text="Erzähl es niemanden aber ich habe ein Frachttruck in die Luft gejagt.." />
		<comment text="Wie ist das möglich, wenn du es von feindlichem Gebiet zurückgefahren hast?" />
		<comment text="Es war aber kein feindlicher Truck, den ich gesprengt habe" />
		<comment text="Oh man, das fetzt nicht" />
		<comment text="In der Tat nicht" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Hast du Kippen für mich?" /> 
		<comment text="Ne, hab keine mehr. Aber seit wann rauchst du denn überhaupt?" />
		<comment text="Tu ich nicht, will sie gegen eine neue Waffe tauschen" />
		<comment text="Was stimmt denn nicht mit deiner aktuellen Waffe?" />
		<comment text="Ich glaub da ist zuviel Sand drin" />
		<comment text="Dann putz sie doch mal kräftig durch?" />
		<comment text="Bah, die haben keine Reinigungwolle mehr im Waffenlager" />
		<comment text="Das gibt's doch nicht" />
		<comment text="Die haben dutzende Waffen, aber nichts um sie zu warten" />
		<comment text="Sieht so aus, als würden die denken, dass wir sowieso nicht lange genug dafür überleben" />
		<comment text="Da könnte was dran sein" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Keine Spur des Funktrucks?" />
		<comment text="Nein, aber bin mir ziemlich sicher, dass er nicht hier ist" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Weisst du was? Ich habe 'ne Flasche Whiskey gefunden und in meinen Lagerraum getan" />
		<comment text="Psst, nicht so laut! Dir ist doch nicht erlaubt sie zu behalten" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Hmm ich dachte neulich..." /> 
		<comment text="Was denn?" />
		<comment text="Uh, Mist ich kann mich nicht mehr erinnern" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Dieser Krieg ist seltsam" />
		<comment text="Wieso denkst du das?" />
		<comment text="Nagut, dann erzähle mir, wieso du hier bist?" />
		<comment text="Hmm hast recht, es wurde uns nie gesagt" />
		<comment text="Nenn mich verrückt aber ich finde das alles ziemlich suspekt" />
		<comment text="Ich glaube wir befreien ein armes Land von einem Tyrannen" />
		<comment text="Für mich klingt es eher nach einer Invasion eines Landes ohne Rücksicht zu nehmen" />
		<comment text="Vielleicht solltest du aufhören zu denken, das könnte uns Schwierigkeiten machen.." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Chef? Wieso tun wir nichts?" />
		<comment text="Hinterfrage Befehle nicht, Junge. Das bringt dich nur um" />
		<comment text="OK Chef"/>      
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Weisst du was mein Lieblingssport ist?" />
		<comment text="Ne?" />
		<comment text="Heisse Kartoffel" />
		<comment text="Ist doch keine Sportart" />       
		<comment text="Ist es wohl, wenn man eine Aufschlaggranate verwendet" />         
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="Ich weiss nicht, ob ich dem Armeechor beitreten soll" />
		<comment text="Was spricht dagegen?" />
		<comment text="Naja das letzte Mal war es beim Kirchenchor"/>  
		<comment text="Und?" /> 
		<comment text="200 Personen haben ihre Religion gewechselt..." />           
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Zum Glück greift der Gegner nicht von hinten an..." />
		<comment text="Ja, dafür wären wir nicht vorbereitet" />
	</dialogue>   
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="Ich habe letztens ein Feuergefecht mit den Entwicklern gehabt" />
		<comment text="Meinst du Pasik und JackMayol ?" />
    <comment text="Yupp, Pasik zielt wie 'ne Oma, aber JackMayol ist noch schlimmer!" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'... Wie kommt man auf so einen Namen?" />
		<comment text="Warte, von was redest du?" />
        <comment text="Ich glaub ich weiss es selbst nicht" />
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="Manchmal hab ich das Gefühl, das wir einfach nur mit Gewehren rennen" />
		<comment text="Sag bloss..." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="Autsch, mein Zeh!" />
		<comment text="Sorry mann" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ist das Spiel schon raus?" />
		<comment text="Na klar, auf Steam!" />
		<comment text="Geil!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck" >
		<comment text="Junge, hast du einen fahren lassen?" />
		<comment text="Kann sein" />
		<comment text="Igitt! Mach das Fenster auf!" />    
	</dialogue>    

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Weisste was?" />
		<comment text="Hmm?" />
		<comment text="Ich glaub ich bin in dich verliebt" />   
		<comment text="Hört sofort auf mit dem Quatsch..." />     
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="Woher hast du deinen Führerschein?" />
