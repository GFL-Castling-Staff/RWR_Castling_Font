	<dialogue key="vehicle dialogue 2 men">
		<comment text="Im Zweifelsfall einfach das Magazin abfeuern" />
		<comment text="Verstanden Sir!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ich habe eine Idee" />
		<comment text="Vergiss es, sowas wie einen perfekten Plan gibt es nicht" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Seid ihr motiviert, Jungs?!" />
		<comment text="Chef, ja Chef!" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Vergesst nicht, was ich euch heute morgen gesagt habe!" />
		<comment text="Ja Chef!" />
		<comment text="Falls unser Angriff zu gut abläuft, ist es ein Hinterhalt!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Ich glaube der Plan ist doof" />
		<comment text="Wenn er doof ist und funktioniert, dann ist er nicht doof" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="Was machen wir, wenn alles versagt?" />
		<comment text="Dann hilft nur noch ein Luftschlag" />
	</dialogue>  

  <dialogue key="vehicle dialogue 2 men">
      <comment text="Wann bist du eigentlich das letzte Mal gefahren?" />
