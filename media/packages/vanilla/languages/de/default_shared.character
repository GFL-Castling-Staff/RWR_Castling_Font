	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Stell dir jetzt eine Pizza vor" />
		<comment text="Oder ein Eis" />
		<comment text="Oder ein Brathähnchen" />
		<comment text="Oder einen Tofusalat" />
		<comment text="Wie bitte !?!" />                
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Woah Junge, hast du ein Friedhof geschluckt heute morgen?" />
		<comment text="Sorry, hab meine Zahnbürste letzte Woche verloren" />    
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Ähm? Für was ist dieser grüne Knopf gut?" />
		<comment text="Uh... für nichts..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Hey, könntest du das Spiel neustarten bitte?" />
		<comment text="Was los?" /> 
		<comment text="Bin in einer Textur blockiert.." />        
	</dialogue>       
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Solltest lieber deinen Helm statt diesem roten Stirnband tragen" />
		<comment text="Hast schon recht, aber sieht viel böser aus" />    
		<comment text="Einer Kugel ist das egal" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Stinkt krass nach Schweissvoxelfüssen hier drin, ekelig!" /> 
	</dialogue>    
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="Willst du ein Kaugummi?" /> 
