	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="Es gibt kein Problem, das nicht mit Sprengstoff gelöst werden kann" /> 
	</dialogue>  
  
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
      <comment text="WAS?! Wieso ist eine Katze im Panzer?" />
