	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
    <comment text="Unterbreche niemals deinen Feind, wenn er einen Fehler macht" />  
    <comment text="" />                                     
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
    <comment text="Gibt so viele Wertgegenstände die auf dem Schlachtfeld rumliegen" />  
    <comment text="Und die meisten Soldaten scheren sich ein Dreck drum" /> 
    <comment text="Ja doof, denn man kann sie für viel Kohle verkaufen" />                                         
