		<comment text="Wir denken alle, dass du einen willst!" />
		<comment text="Öhm, willst du mir damit was sagen...?" />
		<comment text="Du hast es erraten, Kumpel!" />                
	</dialogue> 
  
  <dialogue key="vehicle dialogue 2 men tag=truck">
     <comment text="Kannst du dich an dem Film erinnern, wo der Truckfahrer die Welt rettet?" />
