	<dialogue key="defense dialogue 2 men">
		<comment text="병장님이랑 나는 적 전선 뒤에 있었거든." />
		<comment text="그럼 잠입 임무를 하신겁니까?" />
		<comment text="어, 화물 트럭을 찾아냈지." />
		<comment text="우와, 쩌는데요 그거." />
		<comment text="적진을 정찰하는 게 이러고 서서 시간 낭비하는 것보다는 나았어." />
		<comment text="적어도 죽거나 목숨이 위험하지는 않지 않습니까?" />
		<comment text="이정도 수준이면 그렇겠지." />
	</dialogue>
	
	<dialogue key="defense dialogue 2 men">
		<comment text="엄마한테 내가 군에 있다고 말하지 말아 줘." />
		<comment text="이유라도?" />
		<comment text="엄마는 내가 사창가에서 피아노 치고 있는 줄 알고 계셔." />
		<comment text="어음, 알겠어." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="모든 전쟁이 비현실적인 거 같아." />
		<comment text="으음?" />
		<comment text="한 달 전만해도 '러닝 윗 라이플'을 하고 있었는데 말이야." />
		<comment text="그래, 너는 지금 게임의 일부잖아." />
		<comment text="그러니까." />
		<comment text="만약 네가 '동급생'을 좀 했다고 생각해봐." />
		<comment text="하하하." />            
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="그래서 네가 순찰하러 간 거였나?" />
		<comment text="그렇긴 한데 망했어, 아주 망쳐버렸다고." />
		<comment text="그때 뭘 했길레?" />
		<comment text="아무에게도 말하지 마, 내가 수송 트럭을 날려버렸어." />
		<comment text="적진에서 순찰돌때 그럴 수 있나?" />
		<comment text="아니 그거 적이 아니였어." />
		<comment text="오 맙소사, 그거 끔찍하군." />
		<comment text="그러게 말이야." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="누구 담배 있는 사람?" />
		<comment text="남은게 없어, 니가 담배 필 줄은 몰랐는데?" />
		<comment text="안 돼, 새로운 무기로 교환해야 한단 말이야." />
		<comment text="니가 쓰는거에 무슨 문제가 있는거야?" />
		<comment text="모래가 너무 많이 들어간 것 같아." />
		<comment text="총기손질은 늘 확실하게 해둬야 하잖아." />
		<comment text="뭐, 무기고에서는 늘 손질을 다 해놓은줄 알았는데." />
		<comment text="참나." />
		<comment text="걔들은 무기를 수십 정을 쌓아놓고 산단 말이야." />
		<comment text="우리가 총기손질할 정도로 오래 생존할 거라고 생각하지 않는 것처럼." />
		<comment text="그럼 살아남아서 따지던가." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="누구 통신 트럭 신호를 잡은 사람?" />
		<comment text="없어, 적어도 그 트럭 여기에는 없을 걸?" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="그거 아냐? 위스키를 찾아서 좀 숨겨놨는데." />
		<comment text="쉬잇 큰소리로 말하지마, 우리는 그런거 가지고 있음 큰일나." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="나 지금 뭐 좀 생각해보는데.." />
		<comment text="무슨 생각?" />
		<comment text="으음, 까먹었다." />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="이 전쟁은 참 뭣같아." />
		<comment text="뭐 때문에 그러는데?" />
		<comment text="잘 생각해봐, 우리가 왜 여기 있는지 알고 있어?" />
		<comment text="음 그러네, 상부에서 우리에게 말해준적 없네." />
		<comment text="미친 소리라고 생각할 텐데 수상하단 말이야." />
		<comment text="나는 우리가 이 불쌍한 나라와 그 국민들을 폭군으로부터 해방 시킨다고 생각했는데 말이야." />
		<comment text="내가 보기에 우리는 그 국민을 아랑곳하지 않고 그 땅을 침공하고 있는 것 같은데." />
		<comment text="그거에 대해서 의논하지도 생각하지도 않는 게 좋을 거야, 그렇지 않으면 상부로 불려나갈걸!" />
	</dialogue>

<dialogue key="defense dialogue 2 men">
        <comment text=" 왜 우리는 아무것도 하지 않습니까?" />
        <comment text="야, 묻지마. 코렁탕 마시고 싶냐?" />
        <comment text="시.. 시정하겠습니다!" />  
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="내가 가장 좋아하는 운동이 뭔줄 알아?" />
		<comment text="뭔데?" />
		<comment text="뜨거운 감자." />
		<comment text="그거는 운동이 아니잖아." />       
		<comment text="수류탄으로 하면 스포츠야." />         
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="내가 군 합창단에 들어가야 할지 잘 모르겠어." />
		<comment text="왜?" />
		<comment text="그러니까, 내가 마지막으로 합창단에 있던 때가 교회 합창단 때거든." />  
		<comment text="그리고?" /> 
		<comment text="200 명이나 되는 사람들을 개종시킨거?" />           
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="적들이 후방으로 오지 않아서 다행이야" />
		<comment text="그러게, 우리는 아직 대비하지 못했으니까." />
	</dialogue>   
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="요전에 개발자랑 경쟁전을 했어." />
		<comment text="그러니까 Pasik랑 JackMayol과 함께 했다는거지?" />
		<comment text="그래, Pasik의 조준 실력은 할머니 같은데 JackMayol은 더 심각했어!" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="'Osumia Games'.. 누가 이런 이름을 생각해 낸거지?" />
		<comment text="잠만, 무슨 소리야?" />
        <comment text="나도 내가 뭔 소리하는지 모르겠다." />
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="때때로 우리가 '러닝 윗 라이플'에 일부인 것 같은 기분이야." />
		<comment text="너무 신경쓰는거 아니냐." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="아야 내 발!" />
		<comment text="미안해 친구." />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="이 게임 아직 발매되지 않았나?" />
		<comment text="아닙니다! 스팀에 발매되었습니다!" />
		<comment text="끝내주는군." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="얌마, 니가 방구꼈냐?" />
		<comment text="아마도." />
		<comment text="젠장! 창문열어!" />    
	</dialogue>    

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="너 그거알아?" />
		<comment text="응?" />
		<comment text="난 니가 좋아." />   
		<comment text="그건 아니다.." />     
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="운전면허는 어디서 났냐?" />
		<comment text="너희 어머님꺼." />
	</dialogue> 

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="한번더어어어 때려줘." />
		<comment text="기꺼이 해주지." />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="불안한데." />
		<comment text="왜 그래?" />      
		<comment text="바퀴 점검 때문에." />
		<comment text="무슨 문제가 있길래?" />
		<comment text="바퀴가 엑셀과도 연결되어 있지 않아서." />    
	</dialogue>  

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="라디오 듣고싶어?" />
		<comment text="당연하지." />
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="너랑 같은 분대에 배정받는게 걱정되는데." />
		<comment text="왜 내가 무슨 문제가 있다고?" />
		<comment text="이상한건 늘 문제를 만들어. 너는 이상하다고." />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="아무도 안 볼때는 작전이 성공하고," />
		<comment text="지휘관이 볼때는 늘 실패하지." />
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="충격탄 조심해라." />
		<comment text="그래, 그게 세열수류탄 보다 더 많이 피해를 주니까." />
		<comment text="그래도, 충격 수류탄은 피해 반경이 작아서 다행이야." />    
	</dialogue> 
  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="섬광탄은 네 생각보다 쓸모없지 않거든." />
		<comment text="이것은, 잠시 적들을 무력화시켜." />
		<comment text="엄청 큰 반경에 있는 적들을 말이야!" />    
	</dialogue>     

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="집에 무슨 일이 있으면 어쩌지." />
		<comment text="맥주 마시고 싶다." />
		<comment text="러닝 윗 라이플 좀 하고싶다." />
		<comment text="그래도 그럴 수 없어, 우린 국가를 위해 봉사해야해!" />    
	</dialogue>       
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="다시 무기고로 돌아가야겠어." />
		<comment text="왜?" />
		<comment text="방탄복을 안 입었어." />    
	</dialogue> 
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="군에 있는 진짜 소녀들은 해치지 않을꺼야." />
		<comment text="동감, 우리같은 남자에게 도움이 되지." /><!--성적인 농담-->
		<comment text="아니야, 그런 뜻이 아니야.." />
		<comment text="뭐?" /> 
		<comment text="우리에게는 다림질, 요리 그리고 청소할 사람이 필요하단 말이지." />               
	</dialogue>   

	<dialogue key="vehicle dialogue 2 men">
		<comment text="개발자가 여기에 폴리곤을 더 넣을 수 있었을텐데." />
		<comment text="왜 그런데?" />
		<comment text="뭐, 의자가 날카롭단 말이지." />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="오늘은 금요일, 금요일 *숨쉬는 소리*" /><!--레베카 블랙의 금요일-->
		<comment text="너 가수를 하지 그랬냐." />
		<comment text="정말? 진심으로?" /> 
		<comment text="그래, 그러면 하루 종일 네가 하는 말을 들을 필요가 없을 테니까." />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="새로운 장비를 지급받았어?" />
		<comment text="응." />
		<comment text="아우우, 이건 불공정해..." /> 
   		<comment text="부럽냐?" />    
	</dialogue> 

	<dialogue key="vehicle dialogue 2 men">
		<comment text="좀 비켜줄 수 있나?" />
		<comment text="아니." />
		<comment text="거어 고맙구만." />
		<comment text="칭찬 고오맙구먼." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="너도 알다시피 햇살이 없는 날은, 밤과 같아..." />
		<comment text="허?" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men">
		<comment text="오늘밤 날씨가 어떻게 되지?" />
		<comment text="어두움!" />
		<comment text="..." />
  </dialogue>

 	<dialogue key="vehicle dialogue 2 men">
		<comment text="누구 전화벨 소리야?!" />
		<comment text="그 소리 전화벨 아니야, 다마고치라고." />
	</dialogue>
  
 	<dialogue key="vehicle dialogue 2 men">
		<comment text="pvp에 사람들이 더 많았으면 좋겠어." />
		<comment text="왜?" />
		<comment text="그러면 우리같은 봇들은 죽지 않을거 아니야." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="남은 탄이 있는지 의심스러우면 탄창을 교체합니다." />
		<comment text="네 알겠습니다!" />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="좋은 생각이 났어" />
		<comment text="잊어버려, 완벽한 계획은 없으니까." />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="떨리나 제군들?" />
		<comment text="네, 그렇습니다!" />
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="오늘 아침에 내가 한 말을 잊지 마라." />
		<comment text="네 알겠습니다!" />
		<comment text="우리의 공세가 너무 잘 진행되면 그건 매복이다!" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="이 계획은 바보같아" />
		<comment text="바보같아 보여도 잘되면, 바보같은 계획이 아니야." />
	</dialogue>   
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="모든 것이 실패하면 어떡하지?" />
		<comment text="포격을 불러야지." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men">
		<comment text="마지막으로 운전한게 언제야?" />
		<comment text="오우 이번이 처음이야." />
		<comment text="그럼 왜 운전대를 잡은거야?" />
		<comment text="..." />
		<comment text="분명 우리가 전선에 도착하기 전에 내가 죽고 말거야." />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="" />
		<comment text="" />
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men">
		<comment text="군대에는 2가지 규칙이 있어." />
		<comment text="각각 뭔데?" />
		<comment text="#1: 지휘관은 항상 옳다." />
		<comment text="#2: 만약 옳지 않다고 생각하면 1번을 다시 보라." />       
	</dialogue>           

	<dialogue key="vehicle dialogue 2 men tag=campfire">
		<comment text="내 발이 불타고 있어." />
		<comment text="움직여서 꺼." />
		<comment text="그걸 못하잖아." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="난 이 전차가 너무 좋아." />
		<comment text="입 좀 닥쳐봐." />
		<comment text="그건 안돼." />
	</dialogue>

  <dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="이 전차 이름을 뭐라 지을까?" />
		<comment text="왜 그러는데?" />
		<comment text="뭐 당분간 우리가 쓸거 같으니까..." />
  </dialogue>

	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="최고의 방어구는 사거리 밖에 있는거지." />
		<comment text="똑똑하구만." />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="우리가 스파르으타다!" />
		<comment text="..." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="강철 맛이나 봐라!" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="전차에게 있어서 최고의 지형은 대전차 무기가 없는 곳이로다." /> 
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=any_tank">
		<comment text="고폭탄으로 해결할 수 없는 문제는 없지." /> 
	</dialogue>  
  
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
      <comment text="맙소사, 왜 전차에 고양이가 있어?!" />
      <comment text="야간 투시경이 고장났단 말이야." />
  </dialogue> 
   
  <dialogue key="vehicle dialogue 2 men tag=any_tank">
      <comment text="이걸 왜 우리가 보병 바사삭이라고 부르는지 알아?" />
      <comment text="모르겠군. 이유는?" />
      <comment text="우리가 놈들을 깔아뭉갤 때 나는 소리니까." />
  </dialogue>    
              
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="아야." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="나 속이 안 좋은데." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="이 인간이 어디로 가는지 모르겠다." />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="아직 멀었나?" />
	</dialogue>

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="쿨쿨쿨.." />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="니 면상좀봐ㅋㅋ!" />
		<comment text="뭐 임마?!" />
		<comment text="복셀로 가득찼잖아ㅋㅋ" />     
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="난 공포 영화에서 등장인물이 '누구 있어요?' 라고 말하는 게 좋더라." />
		<comment text="그래 꼭 마치 살인마가 '예 저는 지금 부엌에 있어요, 샌드위치 드실레요?' 하는 것처럼." />   
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="난 플레이어가 차량 내부를 볼 수 있으면 좋겠어." />
		<comment text="그러게 내부 좀 만들었으면, 내부 디테일이 너무 없단 말이야." /> 
		<comment text="개발자야 이게 게임이냐!" />         
	</dialogue>     

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="" />
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="여기서 이러는 거보다, 차밖에 안전할 거야." />
	</dialogue>  

	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="맛있는 피자가 생각나." />
		<comment text="아니면 아이스크림." />
		<comment text="잘익은 치킨도 좋고." />
		<comment text="것도 아니면 두부 샐러드." />
		<comment text="뭣?!" />                 
	</dialogue>
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="으 이런, 아침에 시멘트라도 먹었어?" />
		<comment text="미안, 지난주에 칫솔을 잊어버렸어." />    
	</dialogue>  
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="어음, 이 물건에 녹색이 뭐가 쓸모있어?" />
		<comment text="으음... 쓸모 없을껄..." />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="이봐 거기, 게임 좀 초기화 시켜줄래?" />
		<comment text="무슨 일이야?" /> 
		<comment text="텍스쳐에 낀거같아." />        
	</dialogue>       
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="붉은 머리띠 말고 머리에는 방탄모를 쓰는게 좋아." />
		<comment text="네가 맞긴해, 하지만 간지나 보인다고." />    
		<comment text="총알은 그런거 신경쓰지 않아" />    
	</dialogue> 
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="땀나는 복셀발 냄새인 거 같은데." /> 
	</dialogue>    
  
	<dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="너 풍선껌 씹을래?" /> 
		<comment text="아니" /> 
		<comment text="모두 네가 씹을 것이라 생각했는데" />
		<comment text="엉?, 무슨 뜻이야...?" />
		<comment text="아무것도 아니야, 친구!" />                
	</dialogue> 
  
  <dialogue key="vehicle dialogue 2 men tag=truck">
		<comment text="트럭 운전사들이 하루를 보네는 그 영화를 기억하냐?" />
		<comment text="그럴리가." />
		<comment text="그런가, 나도 몰라 우린 모른체로 죽게 될거야." />
  </dialogue>  
          

	<dialogue key="defense dialogue 2 men">
		<comment text="곧 진급할 것 같아." />
		<comment text="진급전에 죽지나 말라고!" />
		<comment text="고마워, 넌 정말 좋은 친구야" />
	</dialogue>

	<dialogue key="defense dialogue 2 men">
		<comment text="나 지금 기분 끝네주는데" />
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="오늘 100번 정도 재배치한 기분인데." />
		<comment text="그래, 나도 마찬가지야." />  
		<comment text="실제로 상상해봐." />
		<comment text="허." />           
	</dialogue>
  
	<dialogue key="defense dialogue 2 men">
		<comment text="결혼식장에 참석한 노인들이 나를 쿡쿡 찌르고 '다음은 너야'라고 하던데." />
		<comment text="그럼 너는 장례식장에서 똑같이 노인들한테 해라." />     
	</dialogue>    
  
	<dialogue key="defense dialogue 2 men">
		<comment text="그 텔레마케터가 그렇게 짜증날 수가 없어!" />
		<comment text="세살 짜리한테 전화기 들려주고 그녀가 산타라고 말해, 그럼 될꺼야." />     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="지난 밤에 이상한 악몽을 꾸었어." />
		<comment text="어떤 꿈?" />   
		<comment text="모든곳에 1과 0이 있었어." />
		<comment text="그게 뭐가 문제인데?" />
		<comment text="근데 거기서 2를 봤어!" />
		<comment text="으으, 오싹한데." />          
	</dialogue>   
  
	<dialogue key="defense dialogue 2 men">
		<comment text="내 아내가 나보고 못생겼다는데, 불륜녀는 내가 잘생겼다더라." />
		<comment text="그래서?" /> 
		<comment text="어떻게 생각해?" />
		<comment text="흐음 둘다 맞는거 같은데, 내 생각엔 약간 못생긴거 같아." />    
		<comment text="제발, 한 번만이라도 진지해질 수 없어?" /> 
		<comment text="믿어, 진심이야." />              
	</dialogue>      

	<dialogue key="defense dialogue 2 men">
		<comment text="이봐, 말이 참 많은데." />
		<comment text="가문 전통이라더라." /> 
		<comment text="무슨 뜻이야?" />
		<comment text="내 할아버지는 노점상이고, 아버지는 교사였어." />    
		<comment text="어머니는 뭐였는데?" /> 
		<comment text="어머니는 여자였어." />
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
		<comment text="아버지한테 어떻게 이 소식을 전해야 할까?" />
		<comment text="어떤 소식이길레?" /> 
		<comment text="내가 진급에 실패했다는 거" />
		<comment text="전보로 보내" />    
		<comment text="뭐라고 보내?" /> 
		<comment text="'과거 연도의 실적 반복'이라고 보내" />              
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="내 스마트폰이 그리워." />
		<comment text="그래, 페이스북도 없고, 트위터도 없고, 지루하기만 하지." /> 
		<comment text="나는 꺼토미가 가장 그리워." /><!--야동 사이트 이야기--> 
		<comment text="흐음 들어본적 없는데." />
		<comment text="저어엉말로?" />
		<comment text="ㅋㅋㅋ" />                         
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
		<comment text="개발자들이 항공기를 만들지 않아서 다행이야." />
		<comment text="으음 맞아, 뭔지 모르면 걱정해야 하지." /> 
		<comment text="그래, 상공에서 뭐가 오는지 걱정할 필요가 없잖아." />
		<comment text="아파트, 포병대, 박격포... 으아아악!" />
		<comment text="하하하하 비둘기 똥 맞았대요!" /> 
		<comment text="제기랄!" />
	</dialogue>     

	<dialogue key="defense dialogue 2 men">
		<comment text="전문적인 군인들은 예측이 가능해." />  
		<comment text="하지만 세상에 대부분은 예측 불가능한 초짜들뿐이지." />                                      
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
		<comment text="항상 군사 정보에 대해서 이야기하고 싶었는데..." />  
		<comment text="왜 무슨 문제라도 있는거야?" />
		<comment text="군사 정보는 모순 투성이야." /> 
		<comment text="에라, 생각 좀 하고 말해라!" />                                            
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="난 이 게임을 하는 플레이어를 보고싶어." />  
		<comment text="플레이어?" />
		<comment text="그래 화면뒤에서 우리를 보는 사람 말이야." /> 
		<comment text="동감해, 좀 비겁한거 같기도 하고." /> 
		<comment text="그리고 난 플레이어의 그 멍청한 웃음을 참을 수 없다고!" />                                               
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="만약 상관과 성격상 차이로 충돌이 나는 경우." />  
		<comment text="으음?" />
		<comment text="그는 한 성깔을 하는거고, 당신은 문제가 생긴것이다." />                                       
	</dialogue>   

	<dialogue key="defense dialogue 2 men">
		<comment text="지휘관이 더 멍청할수록, 더 중요한 임무를 수행하라는 명령을 받아온다고." />  
		<comment text="너 옳은 말 했다." />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="항상 방법은 존재하지." />  
		<comment text="그리고 대부분은 먹히지 않지." />                                     
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="지휘관의 새 부인을 보았나?" />  
		<comment text="그 긴 코를 가진 여자 말이야?" /> 
		<comment text="그래, 그런 코라면 샤워기 아래에서 담배도 피울 수 있을껄." />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="인간의 조상이 원숭이라는게 사실이야?" />  
		<comment text="그래, 신병은 그렇겠지. 하지만 그 병장은 아닐껄." />                                     
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="최근 입대한 병사들 중에 남자로 변장한 소녀도 있다던데." />  
		<comment text="그럼 걔는 애송이들과 같이 옷도 입고 샤워도 하겠지, 안그래?" /> 
		<comment text="그렇겠지." />  
		<comment text="그럼, 찾아내지 않을까?" /> 
		<comment text="그걸 누가 말하지?" />                                             
	</dialogue>  
  
	<dialogue key="defense dialogue 2 men">
		<comment text="왜 우리는 더욱 비싼 폭탄을 필요로 하지?" />  
		<comment text="필요하지 않을까." /> 
		<comment text="수년간 폭격을 한 사람들이 불만을 가진적이 있었나." />                                        
	</dialogue>      
  
	<dialogue key="defense dialogue 2 men">
		<comment text="왜 우리 병사들이 며칠간 후퇴한 거지?" />  
		<comment text="후퇴한 적 없잖아, 반대 방향으로 진격했다고." />  
		<comment text="아, 알겠어." />                                               
	</dialogue>  

	<dialogue key="defense dialogue 2 men">
		<comment text="군에 입대하려면 올곧을 필요는 없어." />  
		<comment text="알려줘서 고맙군, 친구." />                                     
		<comment text="단지 사격시 올곧은 궤적이 나오면 되." />
	</dialogue>     
  
	<dialogue key="defense dialogue 2 men">
		<comment text="전쟁은 무식한 사람들에게 지리학을 가르치는 신의 방법이지." />  
		<comment text="맞는 말이네" />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
		<comment text="우리의 적이 실수하고 있다면 절대 방해하지 말라." />  
		<comment text="" />                                     
	</dialogue>    

	<dialogue key="defense dialogue 2 men">
		<comment text="전장에 그렇게 많은 귀중품이 널려있다면서." />  
		<comment text="그리고 대부분은 신경쓰지 않지." /> 
		<comment text="무기고에 파는 것도 그만한 가치가 있다던데." />                                         
	</dialogue> 

	<dialogue key="defense dialogue 2 men">
		<comment text="오늘은 매우 집중이 필요한 날이야." />  
		<comment text="특별히 생각한 거는 있어?" /> 
		<comment text="오늘은 유튜버가 되어 비디오를 만들꺼야." />
		<comment text="그럼 바퀴속에 대본이라도 넣어두게?" /> 
		<comment text="맞아, 그게 내 계획이야." />                                                
	</dialogue>  

  <dialogue key="defense dialogue 2 men">
      <comment text="야, 나 궁금한게 생겼어." />
      <comment text="뭔데?" />
      <comment text="도대체 증원군은 어디서 오는 걸까?" />
      <comment text="무슨 뜻이야?" />
      <comment text="내 말은 증원군이 차량을 타고 오진 않잖아." />
      <comment text="너 뇌에 산소가 부족한거 아니야?" />
  </dialogue>

  <dialogue key="defense dialogue 2 men">
      <comment text="너 방구꼈냐?" />
      <comment text="헤헤..." />
      <comment text="이런 망할 창문열어!" />
      <comment text="네, 알겠습니다!" />
  </dialogue>
   
  <dialogue key="defense dialogue 2 men">
      <comment text="왜 이사람은 제대로된 처벌이 없는거지?" />
      <comment text="너의 도마뱀같은 얼굴을 보는 것 만큼은 아니야." />
      <comment text="뭐? 지금 농담한거야?" />
      <comment text="엇, 농담이면 좋겠다 이거야." />
  </dialogue>   
  
	<dialogue key="defense dialogue 2 men">
		<comment text="" />  
		<comment text="" />                                     
	</dialogue> 
  
	<dialogue key="defense dialogue 2 men">
		<comment text="" />  
		<comment text="" />                                     
	</dialogue>    

	<!-- commander comments -->
	<comment key="player promotion" text="좋은 소식일세 제군, 자네는 방금 %rank_name으로 진급했다!" />
	<comment key="we captured a base" text="%base_name 는 이제 아군의 통제 아래 있다." />
	<comment key="we captured a base" text="우리가 %base_name 를 점령했다." />
	<comment key="enemy captured a base" text="%base_name 가 %faction_name 에 의해 점령되었다." />
	<comment key="enemy captured a base" text="%faction_name 가 %base_name 를 점령했다." />
	<comment key="neutral captured a base" text="" />

	<comment key="new attack orders" text="새로운 공격 명령이다, 목표 %base_name로 %direction 쪽이다." />

	<comment key="we have lost our last base" text="우리의 모든 기지를 잃었다. 전투는 이미 끝났다!" />
	<comment key="enemy has lost their last base" text="%faction_name가 패배했다!" />
	
	<comment key="our assault ran out of time" text="우리의 공격은 시간을 지체했다. 전투는 이미 끝났다!" />
	<comment key="enemy assault ran out of time" text="%faction_name가 패배했다!" />

	<comment key="we won by map conquer" text="우리는 이 지역의 모든 기지를 점령했다! 우리가 승리했다!" />
	<comment key="we won by defense timer" text="우리가 승리했다!" />

	<comment key="our base is under attack" text="%base_name 가 공격받고 있다!" />
	<comment key="we are attacking a base" text="우리 부대가 %base_name 를 공격하고 있다." />

	<comment key="fighting near a base" text="%base_name 인근에서 교전이 발생했다." />
	<comment key="fighting near a base" text="%base_name 인근에서 지원 요청을 받았다." />
	<comment key="fighting near a base" text="%base_name 인근에서 총성을 감지했다." />

	<comment key="defense timer started" text="%faction_name가 모든 기지를 점령하고 있다, %time_left초 밖에 남지않았다. 가라!" />
	<comment key="defense timer to go" text="%time_left초 밖에 남지않았다. 빨리 가!" />

  <!-- adventure mode -->
